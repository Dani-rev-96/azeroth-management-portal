# Directus Secrets - BEISPIEL
#
# Anleitung:
# 1. Kopieren: cp directus-secrets.yaml.example directus-secrets.yaml
# 2. Werte eintragen (alle CHANGE_ME Werte ändern!)
# 3. Verschlüsseln: sops -e directus-secrets.yaml > directus-secrets.enc.yaml
# 4. Original löschen: rm directus-secrets.yaml
# 5. Anwenden: sops -d directus-secrets.enc.yaml | kubectl apply -f -
#
apiVersion: v1
kind: Secret
metadata:
  name: directus-secrets
  namespace: wow
type: Opaque
stringData:
  AUTH_KEYCLOAK_CLIENT_SECRET: <secret>
  SECRET: <secret>
  ADMIN_EMAIL: admin@example.com
  ADMIN_PASSWORD: CHANGE_ME_TO_SECURE_PASSWORD
  DB_USER: directus
  DB_PASSWORD: <dbuserpass>
