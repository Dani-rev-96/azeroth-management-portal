# Wedding Access Secret
# Encrypt this file with SOPS before committing:
# sops -e -i wedding-access-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: management-access
  namespace: wow
type: Opaque
stringData:
  # Generate a secure token: openssl rand -base64 24
  access-token: "REPLACE_WITH_SECURE_TOKEN"
