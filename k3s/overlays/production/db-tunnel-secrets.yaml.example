# TEMPLATE — do not apply this file directly. It documents the shape of the
# two secrets the DB tunnel feature consumes. In this repo the real values
# live encrypted in the overlays (SOPS / age).
#
# Generate a keypair with:
#   ssh-keygen -t ed25519 -f db-tunnel -C "wow-portal-db-tunnel" -N ""
#
# Then build the `authorized_key` line below by combining:
#   - a fixed options prefix that locks the key down to port-forwarding only
#     (no shell, no PTY, no agent/X11, restricted target list)
#   - the contents of db-tunnel.pub
#
# Restrictions travel WITH the key so the bastion needs no custom sshd_config.
# Update the permitopen list whenever you add/remove DB targets.
---
apiVersion: v1
kind: Secret
metadata:
  name: db-tunnel-ssh-authorized-keys
  namespace: wow
type: Opaque
stringData:
  # Single-line authorized_keys entry:
  #   <options> <algo> <base64-pubkey> <comment>
  authorized_key: >-
    restrict,port-forwarding,permitopen="wow-acore-auth-db:3306",permitopen="wow-acore-blizzlike-db:3306",permitopen="wow-acore-ip-db:3306",permitopen="wow-acore-ip-boosted-db:3306",permitopen="postgresql:5432"
    ssh-ed25519 AAAA... wow-portal-db-tunnel
---
apiVersion: v1
kind: Secret
metadata:
  name: db-tunnel-ssh-client-key
  namespace: wow
type: Opaque
stringData:
  # Private key mounted into the portal pod and returned to grantees.
  # Replace with the actual privkey (PEM) in your overlay.
  private_key: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    REPLACE_ME
    -----END OPENSSH PRIVATE KEY-----

