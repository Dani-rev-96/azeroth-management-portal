# PostgreSQL Secrets - BEISPIEL
#
# Anleitung:
# 1. Kopieren: cp postgresql-secrets.yaml.example postgresql-secrets.yaml
# 2. Werte eintragen (password ändern!)
# 3. Verschlüsseln: sops -e postgresql-secrets.yaml > postgresql-secrets.enc.yaml
# 4. Original löschen: rm postgresql-secrets.yaml
# 5. Anwenden: sops -d postgresql-secrets.enc.yaml | kubectl apply -f -
#
apiVersion: v1
kind: Secret
metadata:
  name: postgresql-secrets
  namespace: wow
type: Opaque
stringData:
  POSTGRES_USER: directus
  POSTGRES_PASSWORD: <dbuserpass>
  PGDATA: /var/lib/postgresql/data/pgdata
